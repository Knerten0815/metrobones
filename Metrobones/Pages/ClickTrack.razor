@page "/track"

@inherits Layout.MetronomePageBase
@inject ClickTrackStore TrackStore
@inject NavigationManager Navigation

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

<MudStack Spacing=3 AlignItems=AlignItems.Center>
    <MudStack Row=true Spacing=1 AlignItems=AlignItems.Center>
        <MudSwitch Size=@Size.Large Color=@(_countInActive ? Color.Secondary : Color.Primary) @bind-Value=_track.CountIn Class=@(_countInActive ? "no-interact" : "") Label="Count in" />
        <MudNumericField @bind-Value=_track.CountInBars Min=1 Max=10 Disabled=@(_track.CountIn == false) Class="input-center-text" Style="max-width: 3rem"/>
        <MudText> bars.</MudText>
    </MudStack>
    
    <MudDivider/>

    <MudDropContainer T=@ClickTrackSectionData Items=@_track.Sections ItemsSelector=@((item,dropzone) => true) ItemDropped=@MoveSection DraggingClass="" Class="d-flex flex-wrap flex-grow-1">
        <ChildContent>
            <MudDropZone T=@ClickTrackSectionData Class="flex-grow-1" AllowReorder=true ItemDisabled=@(_ => Met.IsRunning) ItemDraggingClass="dragging-track-item"/>
        </ChildContent>
        <ItemRenderer>
            <ClickTrackSection Section=@context CountInActive=@_countInActive CurrentSectionID=@_currentSectionID SectionChanged=@SectionChanged OpenSectionChanged=@UpdateOpenSections StartClicktrack=@StartClickTrack DeleteSection=@DeleteSection/>
        </ItemRenderer>
    </MudDropContainer>

    <MudStack Row=true Justify=@Justify.SpaceAround>
        @* TODO: duplicate sections or duplicate last section or choose section as template *@
        @* TODO: Automatically open newly added section with FocusTrap on title*@
        <MudIconButton OnClick=AddSection Size=@Size.Large Color=@Color.Primary Icon="@Icons.Material.Filled.AddCircleOutline" aria-label="add section" />
    </MudStack>
</MudStack>

@code {
    [Parameter, SupplyParameterFromQuery]
    public int Id { get; set; }

    private bool _isLoading = true;
    private ClickTrackData _track { get; set; } = null!; // Initialized in OnInitializedAsync
    private bool _countInActive = false;
    private int _currentSectionID = -2; // -2 when no section is active, -1 when count-in section is active
    private int _remainingBeats = -1;

    protected override void OnInitialized()
    {
        Met.StopCallback += ResetCountInActive;
        Met.BeatCallback += OnBeat;
    }

    public override async ValueTask DisposeAsync()
    {
        Met.StopCallback -= ResetCountInActive;
        Met.BeatCallback -= OnBeat;
        await base.DisposeAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        ClickTrackData? track = await TrackStore.GetAsync(Id);
        if (track == null)
        {
            Navigation.NavigateTo("/clicktracks");
            return;
        }

        _track = track;
        _isLoading = false;
    }

    private void ResetCountInActive()
    {
        _countInActive = false;
    }

    private void UpdateOpenSections(ClickTrackSectionData? openedSection)
    {
        if(openedSection == null)
            return;
        
        foreach (ClickTrackSectionData section in _track.Sections)
        {
            section.OnTrackSectionOpened?.Invoke(openedSection.ID, openedSection.IsOpen);
        }
    }

    private async Task AddSection()
    {
        ClickTrackSectionData? lastSection = _track.Sections.LastOrDefault();
        ClickTrackSectionData newSection;

        if(lastSection == null)
        {
            newSection = new ClickTrackSectionData(id: 0);
        }
        else
        {
            if(lastSection.MetData.TempoData.IsAgogic == true)
            {
                lastSection.MetData.TempoData = new TempoData(lastSection.MetData.TempoData.EndTempo);
            }

            newSection = new ClickTrackSectionData(lastSection);
        }
        
        _track.Sections.Add(newSection);
        UpdateSectionList();
        UpdateOpenSections(newSection);
        await TrackStore.UpdateAsync(_track);
    }

    private async Task DeleteSection(int id)
    {
        _track.Sections.RemoveAll(s => s.ID == id);
        UpdateSectionList();
        await TrackStore.UpdateAsync(_track);
    }

    private async Task SectionChanged(ClickTrackSectionData section)
    {
        UpdateSectionList();
        await TrackStore.UpdateAsync(_track);
    }

    private async Task MoveSection(MudItemDropInfo<ClickTrackSectionData> dropItem)
    {
        ClickTrackSectionData? section = _track.Sections.FirstOrDefault(s => s.ID == dropItem.Item?.ID);
        if(section == null)
            return;
        
        _track.Sections.Remove(section);
        _track.Sections.Insert(dropItem.IndexInZone, section);
        UpdateSectionList();
        await TrackStore.UpdateAsync(_track);
    }

    private void UpdateSectionList()
    {
        for (int i = 0; i < _track.Sections.Count; i++)
        {
            _track.Sections[i].ID = i;
            _track.Sections[i].MetData.TempoData.PreviousTempo = GetPreviousTempo(i);
            _track.Sections[i].MetData.TempoData.NextTempo = GetNextTempo(i);

            _track.Sections[i].OnTrackAgogicsChanged?.Invoke(i == _track.Sections.Count - 1);
        }
    }

    private int GetPreviousTempo(int i)
    {
        if (i == 0) return -1;

        TempoData prev = _track.Sections[i - 1].MetData.TempoData;
        return prev.IsAgogic ? prev.EndTempo : prev.Tempo;
    }

    private int GetNextTempo(int i)
    {
        if (i >= _track.Sections.Count - 1) return -1;

        TempoData next = _track.Sections[i + 1].MetData.TempoData;
        return next.IsAgogic ? next.StartTempo : next.Tempo;
    }

    private async Task StartClickTrack(ClickTrackSectionData startSection)
    {
        if(startSection == null)
            return;
        
        ClickTrackSectionData section = new ClickTrackSectionData(startSection);

        if(_track.CountIn)
        {
            _countInActive = true;
            section.ID--;
            section.Length = _track.CountInBars;

            if(startSection.MetData.TempoData.IsAgogic)
            {
                section.MetData.TempoData.Tempo = startSection.MetData.TempoData.StartTempo;
                section.MetData.TempoData.IsAgogic = false;
            }
        }

        _currentSectionID = section.ID;
        _remainingBeats = section.Length * section.MetData.NotesPerBar;

        await Met.UpdateSettings(section.MetData, _remainingBeats);
        await Met.Start();
        // update open sections, to disable drag handles
        UpdateOpenSections(section);
    }

    protected async void OnBeat(int currentBeat)
    {
        if(_currentSectionID >= 0 && _track.Sections[_currentSectionID].PlayForever)
            return;
        
        if (_remainingBeats > 1)
        {
            _remainingBeats--;
        }
        else
        {
            _countInActive = false;
            _remainingBeats--;
            int nextSectionIndex = _track.Sections.FindIndex(s => s.ID == _currentSectionID) + 1;

            if (nextSectionIndex < _track.Sections.Count)
            {
                ClickTrackSectionData? nextSection = _track.Sections[nextSectionIndex];
                _currentSectionID = nextSection.ID;
                _remainingBeats = nextSection.Length * nextSection.MetData.NotesPerBar;
                await Met.UpdateSettings(nextSection.MetData, _remainingBeats);
                nextSection.IsOpen = true;
                UpdateOpenSections(nextSection);
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                _currentSectionID = -2;
                _remainingBeats = -1;
                await Met.Stop();
            }
        }
    }
}