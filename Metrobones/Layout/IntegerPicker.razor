
<MudStack Row=@true Spacing=4 Justify=@Justify.Center>
    <MudButton Variant=@Variant.Filled Color=@Color.Primary OnClick=@(() => Increment(-1)) Size=@Size.Large Disabled=@Disabled>-</MudButton>
    <MudNumericField @bind-Value=Value T=int Min=@Min Max=@Max Step=1 HideSpinButtons=@true Class="input-center-text" Style="font-size: 3rem;" Disabled=@Disabled/>
    <MudButton Variant=@Variant.Filled Color=@Color.Primary OnClick=@(() => Increment(1)) Size=@Size.Large Disabled=@Disabled>+</MudButton>
</MudStack>

@code {
    [Parameter]
    public int Value { get; set; } = 4;
    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }
    [Parameter]
    public int Min { get; set; } = 1;
    [Parameter]
    public int Max { get; set; } = 1000;
    [Parameter]
    public bool usePowersOfTwo { get; set; } = false;
    [Parameter]
    public bool Disabled { get; set; } = false;
    
    private void Increment(int increment)
    {
        if (Value + increment < Min || Value + increment > Max)
            return;

        if(usePowersOfTwo)
        {
            if (increment > 0)
                Value *= 2;
            else
                Value /= 2;
        }
        else
        {
            Value += increment;
        }
        
        ValueChanged.InvokeAsync(Value);
    }
}
