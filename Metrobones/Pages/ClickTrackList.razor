@page "/"
@page "/clicktracks"
@using Metrobones.Layout.Dialogs
@inject ISnackbar Snackbar
@inject ClickTrackStore TrackStore
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Click Tracks</PageTitle>

<MudList T="string">
    @foreach(ClickTrackData track in Tracks)
    {
        <MudStack Class="ma-2">
            <MudListItem Text=@track.Title Icon=@Icons.Material.Filled.ArrowForwardIos OnClick=@(() => OpenClickTrack(track.ID)) Style="border-radius: 1rem;">
                <MudStack Row=true Justify=@Justify.SpaceBetween AlignItems=@AlignItems.Center Style="overflow: hidden;">
                    <MudText Style="overflow: hidden; text-overflow: ellipsis;">@track.Title</MudText>
                    <MudStack Row=true>
                        <MudIconButton OnClick=@(async() => await TrackStore.DuplicateAsync(track.ID)) Color=@Color.Primary Icon=@Icons.Material.Outlined.LibraryAdd Size=@Size.Medium aria-label="edit click track" Style="flex-shrink: 0;" />
                        <MudIconButton OnClick=@(async() => await OpenEditTrackDialogAsync(track)) Color=@Color.Primary Icon=@Icons.Material.Outlined.Edit Size=@Size.Medium aria-label="edit click track" Style="flex-shrink: 0;" />
                    </MudStack>
                </MudStack>
            </MudListItem>
            <MudDivider/>
        </MudStack>
    }
</MudList>

<MudStack Row=true Justify=@Justify.Center>
        <MudButton OnClick=@TrackStore.AddAsync Variant=@Variant.Outlined Color=@Color.Primary StartIcon=@Icons.Material.Filled.AddCircleOutline Size=@Size.Large aria-label="add new click track">New Track</MudButton>
        <MudFileUpload @bind-Files=_files AppendMultipleFiles=true Accept=".mid" OnFilesChanged=@ValidateMidiFiles >
            <CustomContent>
                <MudButton OnClick=@context.OpenFilePickerAsync
                           Variant=@Variant.Outlined 
                           Color=@Color.Primary 
                           StartIcon=@Icons.Material.Outlined.FileDownload 
                           Size=@Size.Large 
                           aria-label="add new click track">
                    Import MIDI
                </MudButton>
            </CustomContent>
            @* <SelectedTemplate /> *@
        </MudFileUpload>
</MudStack>

@if (_validFiles != null)
{
    <MudText Typo="@Typo.h6">@_validFiles.Count() File@(_validFiles.Count() == 1 ? "" : "s"):</MudText>
    @if (_validFiles.Count > 0)
    {
        <MudFlexBreak />
        <MudList T="string">
            @foreach (var file in _validFiles)
            {
                <MudListItem Icon="@Icons.Material.Filled.AttachFile" @key="@file">
                    @file.Name <code>@file.Size bytes</code>
                </MudListItem>
            }
        </MudList>
    }
}

@code{
    public List<ClickTrackData> Tracks { get; set; } = new List<ClickTrackData>();
    private IReadOnlyList<IBrowserFile> _files = new List<IBrowserFile>();
    List<IBrowserFile> _validFiles = new List<IBrowserFile>();
    
    private void ShowInvalidMidiSnackbar(string fileName)
    {
        Snackbar.Add("File " + fileName + " is not a valid MIDI file.", Severity.Error);
    }

    private async Task ValidateMidiFiles()
    {
        Console.WriteLine("Validating MIDI files...");
        
        foreach (IBrowserFile file in _files)
        {
            if (file.ContentType != "audio/midi" && !file.Name.EndsWith(".mid", StringComparison.OrdinalIgnoreCase))
            {
                Console.WriteLine("Calling Snackbar");
                ShowInvalidMidiSnackbar(file.Name);
                continue;
            }
            _validFiles.Add(file);
        }

        @* foreach (IBrowserFile file in _files)
        {
            using Stream stream = file.OpenReadStream();
            await TrackStore.ImportFromMidiAsync(stream, file.Name);
        } *@

        @* _files = new List<IBrowserFile>(); *@
    }
    
    protected override async Task OnInitializedAsync()
    {
        Snackbar.Clear();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomStart;

        Tracks = await TrackStore.GetAllAsync();
    }

    private void OpenClickTrack(int trackID)
    {
        Navigation.NavigateTo($"track?id={trackID}");
    }

    private async Task OpenEditTrackDialogAsync(ClickTrackData track)
    {
        DialogParameters<EditClickTrackDialog>? parameters = new DialogParameters<EditClickTrackDialog>{
            { x => x.ClickTrackTitle, track.Title },
            { x => x.ClickTrackID, track.ID }
        };

        IDialogReference? dialog = await DialogService.ShowAsync<EditClickTrackDialog>(title: "Edit Click Track", parameters);
        DialogResult? result = await dialog.Result;
        
        if (result?.Canceled == false)
        {
            track.Title = (string?)result.Data ?? track.Title;
            await TrackStore.UpdateAsync(track);
        }
    }
}