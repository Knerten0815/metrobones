@page "/settings"
@inject Services.ThemeManager ThemeManager
@inherits MetronomePageBase

@using Metrobones.Layout

<PageTitle>Settings</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

<MudStack>
    <MudText Typo=@Typo.h4 Class="my-4">Appearance</MudText>
    <MudStack Row=true AlignItems=@AlignItems.Center>
        <MudSelect Label="Color Theme" @bind-Value=@ThemeManager.Theme T=@MudTheme>
            @foreach(KeyValuePair<string, MudBlazor.MudTheme> kvp in ThemeManager.ThemeDict)
            {
                <MudSelectItem Value=@kvp.Value>@kvp.Key</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
    <MudStack Row=true AlignItems=@AlignItems.Center Justify=@Justify.Center>
        <MudSwitch @bind-Value=@ThemeManager.UseDarkMode Label="Dark mode" LabelPlacement=@Placement.Start Color=@Color.Primary/>
    </MudStack>
</MudStack>

<MudStack>
    <MudText Typo=@Typo.h4 Class="my-4">Click</MudText>
    <MudStack Row=true AlignItems=@AlignItems.Center>
        <MudSelect Label="Sound" @bind-Value=@_currentSound @bind-Value:after=UpdateSound T=@string>
            @foreach(string sound in _sounds)
            {
                <MudSelectItem Value=@sound.ToLower() >@sound</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
    <ValuePicker Label="Gain" @bind-Value=_volume @bind-Value:after=UpdateSound Min=0 Max=2 Step=0.1/>
    <ValuePicker Label="On-beat pitch" AdornmentText="Hz" @bind-Value=_onBeatPitch @bind-Value:after=UpdateSound Min=20 Max=20000 Logarithmic=true/>
    <ValuePicker Label="Off-beat pitch" AdornmentText="Hz" @bind-Value=_offBeatPitch @bind-Value:after=UpdateSound Min=20 Max=20000 Logarithmic=true/>
    <MudStack Row=true AlignItems=@AlignItems.Center Justify=@Justify.Center>
        <MudText>Test click: </MudText>
        <PlayButton OnPlay=@PlayTestClick />
    </MudStack>
    <MudButton OnClick=@ResetSound Variant=@Variant.Filled Color=@Color.Primary>Reset click sound</MudButton>
</MudStack>

@code
{
    private bool _isLoading = true;
    private string[] _sounds = {"Sine", "Square", "Sawtooth", "Triangle"};
    private string _currentSound = "sine";
    private double _volume = 1;
    private double _onBeatPitch = 1500;
    private double _offBeatPitch = 1000;
    private MetronomeData _testMetronome = new MetronomeData();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        await ThemeManager.InitializeAsync();
        await base.OnInitializedAsync();
        _isLoading = false;
    }

    private async Task PlayTestClick()
    {
        await Met.Update(_testMetronome, sectionBeatCount: -1);
        await Met.Start();
    }

    private async Task UpdateSound()
    {
        await Met.UpdateSound(_volume, _currentSound, _onBeatPitch, _offBeatPitch);
    }

    private async Task ResetSound()
    {
        _currentSound = "sine";
        _volume = 1;
        _onBeatPitch = 1500;
        _offBeatPitch = 1000;
        await UpdateSound();
    }
}
