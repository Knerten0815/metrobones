@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject ClickTrackStore TrackStore
@inject ThemeManager ThemeManager

<MudThemeProvider Theme=@ThemeManager.Theme IsDarkMode=@ThemeManager.UseDarkMode/>
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey=true />
@* <MudSnackbarProvider /> *@
<UpdatePWA />

<MudLayout>
    <MudAppBar Elevation=1 Dense=@true>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />
        <MudIcon Icon="@_currentLogoSvgText" Color="Color.Inherit"></MudIcon>
        <MudText Typo=@Typo.h5 Class="ml-3" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_pageTitle</MudText>
        <MudSpacer />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth=@MaxWidth.ExtraSmall>
                @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = false;
    string _pageTitle = "Click Tracks";
    string _currentLogoSvgText = CustomIcons.Logo;
    private DialogOptions _options = new DialogOptions { CloseOnEscapeKey = true };

    static readonly Dictionary<string, string> _pageTitles = new(StringComparer.OrdinalIgnoreCase)
    {
        [""] = "Click Tracks",
        ["clicktracks"] = "Click Tracks",
        ["metronome"] = "Metronome",
        ["setlists"] = "Set Lists",
        ["settings"] = "Settings"
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChangedAsync;
        ThemeManager.OnThemeChanged += OnThemeChangedAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        await ThemeManager.InitializeAsync();
        _pageTitle = await GetPageTitleAsync(Navigation.Uri);
    }

    private async void OnThemeChangedAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnLocationChangedAsync(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _pageTitle = await GetPageTitleAsync(e.Location);
        // flip the pendulum logo on each page change for fun
        _currentLogoSvgText = _currentLogoSvgText == CustomIcons.Logo ? CustomIcons.LogoFlipped : CustomIcons.Logo;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<string> GetPageTitleAsync(string uri)
    {
        var relativePath = Navigation.ToBaseRelativePath(uri);

        if (_pageTitles.TryGetValue(relativePath.Trim('/'), out var title))
            return title;

        // Extract the ID from the path or query string, e.g. /track?id=5
        if (int.TryParse(relativePath.Split("=").Last(), out int trackId))
        {
            ClickTrackData? track = await TrackStore.GetAsync(trackId);
            if (track != null)
                return track.Title;
        }

        return "Metrobones";
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChangedAsync;
        ThemeManager.OnThemeChanged -= OnThemeChangedAsync;
    }
}