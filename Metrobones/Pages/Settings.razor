@page "/settings"
@inject Services.ThemeManager ThemeManager
@inherits MetronomePageBase

@using Metrobones.Layout

<PageTitle>Settings</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

<MudStack>
    <MudText Typo=@Typo.h4 Class="my-4">Appearance</MudText>
    <MudStack Row=true AlignItems=@AlignItems.Center>
        <MudText>Color Theme: </MudText>
        <MudSelect @bind-Value=@ThemeManager.Theme T=@MudTheme>
            @foreach(KeyValuePair<string, MudBlazor.MudTheme> kvp in ThemeManager.ThemeDict)
            {
                <MudSelectItem Value=@kvp.Value>@kvp.Key</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
    <MudStack Row=true AlignItems=@AlignItems.Center Justify=@Justify.SpaceBetween>
        <MudText>Dark mode: </MudText>
        <MudSwitch @bind-Value=@ThemeManager.UseDarkMode Color=@Color.Primary/>
    </MudStack>
</MudStack>

<MudStack>
    <MudText Typo=@Typo.h4 Class="my-4">Click</MudText>
    <MudStack Row=true AlignItems=@AlignItems.Center>
        <MudText>Sound: </MudText>
        <MudSelect @bind-Value=@_currentSound T=@string>
            @foreach(string sound in _sounds)
            {
                <MudSelectItem Value=@sound.ToLower() >@sound</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
    <MudStack Row=true AlignItems=@AlignItems.Center>
        <MudText>Volume: </MudText>
        <MudNumericField @bind-Value=@_volume Min="1" Max="100" Step="1"/>
    </MudStack>
    <MudStack Row=true AlignItems=@AlignItems.Center>
        <MudText>On-beat pitch: </MudText>
        <MudNumericField @bind-Value=@_onBeatPitch Min="20" Max="20000" Step="100"/>
    </MudStack>
    <MudStack Row=true AlignItems=@AlignItems.Center>
        <MudText>Off-beat pitch: </MudText>
        <MudNumericField @bind-Value=@_offBeatPitch Min="20" Max="20000" Step="100"/>
    </MudStack>
    <MudStack Row=true AlignItems=@AlignItems.Center Justify=@Justify.Center>
        <MudText>Test click: </MudText>
        <PlayButton OnPlay=@PlayTestSound />
    </MudStack>
</MudStack>

@code
{
    private bool _isLoading = true;
    private string[] _sounds = {"Sine", "Square", "Sawtooth", "Triangle"};
    private string _currentSound = "sine";
    private int _volume = 100;
    private int _onBeatPitch = 1500;
    private int _offBeatPitch = 1000;
    private MetronomeData _testMetronome = new MetronomeData();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        await ThemeManager.InitializeAsync();
        await base.OnInitializedAsync();
        _isLoading = false;
    }

    private async Task PlayTestSound()
    {
        await Met.UpdateSettings(_testMetronome, sectionBeatCount: -1);
        await Met.Start();
    }
}
