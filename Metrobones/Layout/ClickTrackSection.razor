@inherits Layout.MetronomePageBase

<MudExpansionPanel Expanded=@Section.IsOpen ExpandedChanged=@OpenSection>
    <TitleContent>
        <MudStack AlignItems=@AlignItems.Center Row=true>
            <MudDragHandle T=@ClickTrackSectionData >
                <MudIcon Icon=@Icons.Material.Filled.DragHandle aria-label="drag" Style=@(Met.IsRunning ? "color: var(--mud-palette-action-disabled);" : null) />
            </MudDragHandle>
            @if (Section.IsOpen)
            {
                <MudTextField @bind-Value=Section.Title T=string @onclick:stopPropagation @onkeydown:stopPropagation id=@("section" + Section.ID)/>
            }
            else
            {
                <MudChip Variant=@Variant.Text Size=@Size.Small T=string Color=@(Section.PlayForever ? Color.Secondary : Color.Default)>@(Section.PlayForever ? "∞" : $"{Section.Length}x")</MudChip>
                <MudText>@Section.Title</MudText>
            }
        </MudStack>
    </TitleContent>

    <ChildContent>
        <ClickTrackSectionExpanded
            Section=@Section 
            CountInActive=@CountInActive 
            SectionChanged=@SectionChanged 
            StartClicktrack=@StartClicktrack
            DeleteSection=@DeleteSection
        />
    </ChildContent>
</MudExpansionPanel>


@code {
    [Parameter]
    public int CurrentSectionID { get; set; }
    
    [Parameter]
    public bool CountInActive { get; set; }

    [Parameter, EditorRequired]
    public ClickTrackSectionData Section {get; set;} = null!;

    [Parameter]
    public EventCallback<ClickTrackSectionData> SectionChanged { get; set; }
    
    [Parameter]
    public EventCallback<ClickTrackSectionData> StartClicktrack{ get; set; }

    [Parameter]
    public EventCallback<int> DeleteSection{ get; set; }

    private bool IsActiveSection()
    {
        if(CountInActive)
            return CurrentSectionID == Section.ID - 1;
        
        return CurrentSectionID == Section.ID;
    }

    protected override void OnInitialized()
    {
        Section.OnTrackAgogicsChanged += UpdateAgogics;
    }

    public override async ValueTask DisposeAsync()
    {
        Section.OnTrackAgogicsChanged -= UpdateAgogics;
        await base.DisposeAsync();
    }

    private void UpdateAgogics(bool isLastSection)
    {
        Section.MetData.TempoData.UpdateAgogics(hasPreviousSection: Section.ID == 0, isLastSection);
    }

    protected override void OnParametersSet()
    {
        if(Met.IsRunning == false)
            return;
        
        Section.IsOpen = IsActiveSection();

        if(Section.IsOpen == false)
            return;
        
        if (Met.CurrentBeat != 1)
            return;
    }

    private void OpenSection(bool shouldOpen){
        if (Met.IsRunning)
        {
            Section.IsOpen = IsActiveSection() && shouldOpen;
        }
        else
        {
            Section.IsOpen = shouldOpen;
        }
    }
}