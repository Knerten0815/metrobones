@page "/metronome"

@inherits Layout.MetronomePageBase
@inject SoundManager SoundSettings

<PageTitle>Metronome</PageTitle>

<MudStack Spacing=4>
    <TempoPicker @bind-Tempo=Met.Data.TempoData.Tempo @bind-Tempo:after=Met.Update />

    <TimeSignaturePicker @bind-BeatsPerBar=Met.Data.NotesPerBar @bind-BeatsPerBar:after=Met.UpdateNotesPerBar
                         @bind-NoteValue=Met.Data.NoteValue @bind-NoteValue:after=Met.Update 
                         @bind-Subdivisions=Met.Data.Subdivisions @bind-Subdivisions:after=Met.UpdateNotesPerBar/>

    <BeatAccenting @bind-BeatAccents=Met.Data.BeatAccents @bind-BeatAccents:after=Met.Update
                   NotesPerBar=Met.Data.NotesPerBar Label="Edit Accenting" DisableWhenMetronomeRunning=@false/>

    <PlayButton OnPlay=Play/>
</MudStack>

@code{
    protected override void OnInitialized()
    {
        Met.MediaSessionPlayCallback += OnMediaSessionPlay;
    }

    public override async ValueTask DisposeAsync()
    {
        Met.MediaSessionPlayCallback -= OnMediaSessionPlay;
        await base.DisposeAsync();
    }

    private async void OnMediaSessionPlay()
    {
        await Play();
    }

    private async Task Play()
    {
        await SoundSettings.InitializeAsync();
        SoundData sound = SoundSettings.GetDefaultsSnapshot();
        await Met.UpdateSound(sound.Volume * 0.01d, sound.Waveform, sound.OnBeatPitch, sound.OffBeatPitch);
        await Met.Update();
        await Met.Start();
    }
}
