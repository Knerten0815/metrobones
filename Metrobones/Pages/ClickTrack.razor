@page "/track"

@using System.ComponentModel.DataAnnotations
@inherits Layout.MetronomePageBase
@inject ClickTrackStore TrackStore
@inject NavigationManager Navigation

<MudStack Spacing=3 AlignItems=AlignItems.Center>
    <MudStack Row=true Spacing=1 AlignItems=AlignItems.Center>
        <MudSwitch Size=@Size.Large Color=@(_countInActive ? Color.Secondary : Color.Primary) @bind-Value=_track.CountIn Class="@(_countInActive ? "no-interact" : "")" Label="Count in" />
        <MudNumericField @bind-Value=_track.CountInBars Min=1 Max=10 Disabled=@(_track.CountIn) Class="input-center-text" Style="max-width: 3rem"/>
        <MudText> bars.</MudText>
    </MudStack>
    @* <MudText>Remaining=@_remainingBeats Current=@Met.CurrentBeat</MudText> *@
    <MudDropContainer T=@Models.ClickTrackSection Items=@_track.Sections ItemsSelector="@((item,dropzone) => true)" ItemDropped=@MoveSection Class="d-flex flex-wrap flex-grow-1">
        <ChildContent>
            <MudExpansionPanels Class="mud-width-full">
                <MudDropZone T=@Models.ClickTrackSection Class="flex-grow-1" AllowReorder="true" ItemsClassSelector=@((item) => item.IsOpen ? "drop-item-disabled" : "")/>
            </MudExpansionPanels>
        </ChildContent>
        <ItemRenderer>
            <ClickTrackSection Section=@context RemainingBars=@(Met.IsRunning ? _remainingBeats / context.MetData.NotesPerBar : context.Length) SectionChanged=@SectionChanged CurrentSectionID=_currentSectionID StartClicktrack=StartClickTrack DeleteSection=DeleteSection/>
        </ItemRenderer>
    </MudDropContainer>

    <MudStack Row=true Justify=@Justify.SpaceAround>
        @* TODO: duplicate sections or duplicate last section or choose section as template *@
        @* TODO: Automatically open newly added section with FocusTrap on title*@
        <MudIconButton OnClick=AddSection Size=@Size.Large Color=@Color.Primary Icon="@Icons.Material.Filled.AddCircleOutline" aria-label="add section" />
    </MudStack>
</MudStack>

@code {
    [Parameter, SupplyParameterFromQuery]
    public int Id { get; set; }
    public Models.ClickTrack _track { get; set; } = new Models.ClickTrack();
    private bool _countInActive;
    private int _countInBeats = 8;
    private int _currentSectionID = -1;
    private int _remainingBeats = -1;

    protected override void OnInitialized()
    {
        Met.StopCallback += ResetCountInActive;
    }

    // Validation in OnParametersSet, because OnInitialized is not called when navigating from /track/1 to /track/2
    protected override async Task OnParametersSetAsync()
    {
        _track = await TrackStore.GetAsync(Id);
        if (_track == null)
        {
            Navigation.NavigateTo("/clicktracks", true);
            await Task.FromCanceled(new CancellationToken());
        }
    }

    private void ResetCountInActive()
    {
        _countInActive = false;
    }

    private async Task AddSection()
    {
        int newID = _track.Sections.Count > 0 ? _track.Sections.Max(s => s.ID) + 1 : 0;
        _track.Sections.Add(item: new Models.ClickTrackSection(newID));
        StateHasChanged();
        await TrackStore.UpdateAsync(_track);
    }

    private async Task DeleteSection(int id)
    {
        _track.Sections.RemoveAll(s => s.ID == id);
        StateHasChanged();
        await TrackStore.UpdateAsync(_track);
    }

    private async Task SectionChanged(Models.ClickTrackSection section)
    {
        int index = _track.Sections.FindIndex(s => s.ID == section.ID);
        if (index != -1)
        {
            _track.Sections[index] = section;
            StateHasChanged();
            await TrackStore.UpdateAsync(_track);
        }
    }

    private async Task MoveSection(MudItemDropInfo<Models.ClickTrackSection> dropItem)
    {
        Models.ClickTrackSection? section = _track.Sections.FirstOrDefault(s => s.ID == dropItem.Item?.ID);
        if(section == null)
            return;
        
        _track.Sections.Remove(section);
        _track.Sections.Insert(dropItem.IndexInZone, section);

        // Reassign IDs
        for (int i = 0; i < _track.Sections.Count; i++)
        {
            _track.Sections[i].ID = i;
        }

        await TrackStore.UpdateAsync(_track);
    }

    private async Task StartClickTrack(Models.ClickTrackSection startSection)
    {
        if(startSection == null)
            return;
        
        _currentSectionID = startSection.ID;
        _remainingBeats = startSection.Length * startSection.MetData.NotesPerBar;

        if(_track.CountIn)
        {
            _countInActive = true;
            _countInBeats = _track.CountInBars * startSection.MetData.NotesPerBar;
            _remainingBeats += _countInBeats;
        }

        await Met.UpdateSettings(startSection.MetData);
        await Met.Start();
    }

    protected override async void OnStateChanged()
    {
        if (_remainingBeats > 1)
        {
            _remainingBeats--;
            _countInBeats--;
            if (_countInBeats <= 0)
                _countInActive = false;
        }
        else
        {
            _remainingBeats--;
            int nextSectionIndex = _track.Sections.FindIndex(s => s.ID == _currentSectionID) + 1;

            if (nextSectionIndex < _track.Sections.Count)
            {
                var nextSection = _track.Sections[nextSectionIndex];
                _currentSectionID = nextSection.ID;
                _remainingBeats = nextSection.Length * nextSection.MetData.NotesPerBar;
                await Met.UpdateSettings(nextSection.MetData);
            }
            else
            {
                _currentSectionID = -1;
                _remainingBeats = -1;
                await Met.Stop();
            }
        }
        
        base.OnStateChanged();
    }
}