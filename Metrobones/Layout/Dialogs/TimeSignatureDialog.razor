<MudDialog>
    <DialogContent>
        <TimeSignaturePicker @bind-BeatsPerBar=BeatsPerBar @bind-NoteValue=NoteValue @bind-Subdivisions=Subdivisions/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter, EditorRequired]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int BeatsPerBar { get; set; }

    [Parameter]
    public int NoteValue { get; set; }
    [Parameter]
    public int Subdivisions { get; set; }

    private void Submit()
    {
        MetronomeData data = new MetronomeData(notesPerBar: BeatsPerBar, noteValue: NoteValue, subdivisions: Subdivisions);
        MudDialog.Close(DialogResult.Ok(result: data));
    }

    private void Cancel() => MudDialog.Cancel();
}
