<MudDialog>
    <DialogContent>
        <MudStack Row=@true Spacing=4 Justify=@Justify.Center>
            <MudButton Variant=@Variant.Filled Color=@Color.Primary OnClick=@(() => IncrementLength(-1)) Size=@Size.Large Disabled=@Result.PlayForever>-</MudButton>
            <MudNumericField @bind-Value=Result.Length T=int Min=1 Max=1000 Step=1 HideSpinButtons=@true Class="input-center-text" Style="font-size: 3rem;" Disabled=@Result.PlayForever/>
            <MudButton Variant=@Variant.Filled Color=@Color.Primary OnClick=@(() => IncrementLength(1)) Size=@Size.Large Disabled=@Result.PlayForever>+</MudButton>
        </MudStack>
        <br/>
        <MudCheckBox @bind-Value=@Result.PlayForever Label="play forever" Color=@Color.Primary Style="margin: 0 -1rem;"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter, EditorRequired]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public EditLength Result { get; set; } = null!;

    public class EditLength
    {
        public int Length { get; set; }
        public bool PlayForever { get; set; }
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(result: Result));

    private void Cancel() => MudDialog.Cancel();

    private void IncrementLength(int increment)
    {
        if (Result.Length + increment < 1 || Result.Length + increment > 1000)
            return;

        Result.Length += increment;
    }
}
