@inject Services.Metronome Met

<MudStack Row=@true Spacing=2 Justify=@Justify.SpaceEvenly>
    @if (Met.IsRunning)
    {
        <MudIconButton OnClick=@Met.Stop Color=@Color.Secondary Icon=@Icons.Material.Filled.Stop Size=@Size.Large Variant=@Variant.Filled Class="rounded-xl mud-elevation-3"aria-label="Stop" />
    }
    else
    {
        <MudIconButton OnClick=@OnPlay Color=@Color.Primary Icon=@Icons.Material.Filled.PlayArrow Size=@Size.Large Variant=@Variant.Filled Class="rounded-xl mud-elevation-2" aria-label="Start" />
    }
</MudStack>

@code {
    [Parameter]
    public EventCallback OnPlay { get; set; }
}