@page "/"
@page "/clicktracks"
@using System.Globalization
@using Melanchall.DryWetMidi.Core
@using Melanchall.DryWetMidi.Interaction
@using Metrobones.Layout.Dialogs
@inject ISnackbar Snackbar
@inject ClickTrackStore TrackStore
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Click Tracks</PageTitle>

<MudList T="string">
    @foreach(ClickTrackData track in Tracks)
    {
        <MudStack Class="ma-2">
            <MudListItem Text=@track.Title Icon=@Icons.Material.Filled.ArrowForwardIos OnClick=@(() => OpenClickTrack(track.ID)) Style="border-radius: 1rem;">
                <MudStack Row=true Justify=@Justify.SpaceBetween AlignItems=@AlignItems.Center Style="overflow: hidden;">
                    <MudText Style="overflow: hidden; text-overflow: ellipsis;">@track.Title</MudText>
                    <MudStack Row=true>
                        <MudIconButton OnClick=@(async() => await TrackStore.DuplicateAsync(track.ID)) Color=@Color.Primary Icon=@Icons.Material.Outlined.LibraryAdd Size=@Size.Medium aria-label="edit click track" Style="flex-shrink: 0;" />
                        <MudIconButton OnClick=@(async() => await OpenEditTrackDialogAsync(track)) Color=@Color.Primary Icon=@Icons.Material.Outlined.Edit Size=@Size.Medium aria-label="edit click track" Style="flex-shrink: 0;" />
                    </MudStack>
                </MudStack>
            </MudListItem>
            <MudDivider/>
        </MudStack>
    }
</MudList>

<MudStack Row=true Justify=@Justify.Center>
        <MudButton OnClick=@TrackStore.AddNewAsync Variant=@Variant.Outlined Color=@Color.Primary StartIcon=@Icons.Material.Filled.AddCircleOutline Size=@Size.Large aria-label="add new click track">New Track</MudButton>
        <MudFileUpload @bind-Files=_files AppendMultipleFiles=true Accept=".mid" OnFilesChanged=@OnFilesChanged >
            <CustomContent>
                <MudButton OnClick=@context.OpenFilePickerAsync
                           Variant=@Variant.Outlined 
                           Color=@Color.Primary 
                           StartIcon=@Icons.Material.Outlined.FileDownload 
                           Size=@Size.Large 
                           aria-label="add new click track">
                    Import MIDI
                </MudButton>
            </CustomContent>
            @* <SelectedTemplate /> *@
        </MudFileUpload>
</MudStack>

@if (_validFiles != null)
{
    <MudText Typo="@Typo.h6">@_validFiles.Count() File@(_validFiles.Count() == 1 ? "" : "s"):</MudText>
    @if (_validFiles.Count > 0)
    {
        <MudFlexBreak />
        <MudList T="string">
            @foreach (var file in _validFiles)
            {
                <MudListItem Icon="@Icons.Material.Filled.AttachFile" @key="@file">
                    @file.Name <code>@file.Size bytes</code>
                </MudListItem>
            }
        </MudList>
    }
}

@code{
    public List<ClickTrackData> Tracks { get; set; } = new List<ClickTrackData>();
    private IReadOnlyList<IBrowserFile> _files = new List<IBrowserFile>();
    private List<IBrowserFile> _validFiles = new List<IBrowserFile>();
    private ReadingSettings _midiReadingSettings = new ReadingSettings
    {
        MissedEndOfTrackPolicy = MissedEndOfTrackPolicy.Ignore,
        @* InvalidChannelEventParameterValuePolicy = InvalidChannelEventParameterValuePolicy.ReadValid,
        InvalidChunkSizePolicy = InvalidChunkSizePolicy.Ignore,
        InvalidMetaEventParameterValuePolicy = InvalidMetaEventParameterValuePolicy.SnapToLimits,
        NoHeaderChunkPolicy = NoHeaderChunkPolicy.Ignore,
        NotEnoughBytesPolicy = NotEnoughBytesPolicy.Ignore,
        UnexpectedTrackChunksCountPolicy = UnexpectedTrackChunksCountPolicy.Ignore,
        UnknownChannelEventPolicy = UnknownChannelEventPolicy.SkipStatusByteAndOneDataByte,
        UnknownChunkIdPolicy = UnknownChunkIdPolicy.ReadAsUnknownChunk,
        UnknownFileFormatPolicy = UnknownFileFormatPolicy.Ignore, *@
    };

    private async Task<Dictionary<string, MidiFile>> ValidateMidiFilesAsync()
    {
        Dictionary<string, MidiFile> validMidis = new Dictionary<string, MidiFile>();
        foreach (IBrowserFile file in _files)
        {
            if(file == null)
            {
                Console.Error.WriteLine("Null file encountered in file list.");
                continue;
            }

            try
            {
                await using Stream sourceStream = file.OpenReadStream();
                await using MemoryStream bufferedStream = new MemoryStream();
                await sourceStream.CopyToAsync(bufferedStream);
                bufferedStream.Position = 0;

                MidiFile midiFile = MidiFile.Read(bufferedStream, _midiReadingSettings);

                if(midiFile.OriginalFormat == MidiFileFormat.MultiSequence)
                {
                    Snackbar.Add("MIDI format 2 is not supported: " + file.Name, Severity.Error);
                    continue;
                }

                validMidis[file.Name] = midiFile;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error reading MIDI file {file.Name}: \n{ex.Message}: \n{ex.StackTrace}");
                Snackbar.Add("File " + file.Name + " is not a valid MIDI file.", Severity.Error);
                continue;
            }
        }

        return validMidis;
    }

    private string GetMidiTitle(MidiFile midiFile)
    {
        ICollection<TimedEvent>? timedEvents = midiFile.GetTimedEvents();
        foreach (TimedEvent timedEvent in timedEvents)
        {
            SequenceTrackNameEvent? nameEvent = timedEvent.Event as SequenceTrackNameEvent; 
            if(nameEvent == null)
                continue;

            return nameEvent.Text;
        }

        return string.Empty;
    }

    private ClickTrackData MidiToClickTrack(MidiFile midiFile)
    {
        TimedEventDetectionSettings settings = new();
        TimedEvent[] midiEvents = [.. midiFile.GetTimedEvents()];
        TempoMap map = midiFile.GetTempoMap();
        ClickTrackData clickTrack = new ClickTrackData();
        ClickTrackSectionData currentSection = new();
        ClickTrackSectionData lastSection = new();
        bool skipToAgogicsEnd = false;
        BarBeatTicksTimeSpan lastTime = new();
        BarBeatTicksTimeSpan currentTime = new();
        int bpm = 120;
        for(int i = 0; i < midiEvents.Length; i++)
        {
            Console.WriteLine(midiEvents[i]);
            MidiEvent midi = midiEvents[i].Event;
            currentTime = midiEvents[i].TimeAs<BarBeatTicksTimeSpan>(map);

            // check if we need a new section
            if (lastTime != currentTime && !skipToAgogicsEnd)
            {
                // set length and add section
                currentSection.Length = (int)(currentTime.Bars - lastTime.Bars);
                clickTrack.Sections.Add(currentSection);

                // reset algorithm
                lastSection = currentSection;
                currentSection = new(currentSection);
                currentSection.MetData.TempoData.IsAgogic = false;
                currentSection.Title = $"Bar {currentTime.Bars + 1}";
                lastTime = currentTime;
            }

            // parse midi event
            if (midi is SequenceTrackNameEvent sequenceTrackNameEvent)
            {
                clickTrack.Title = sequenceTrackNameEvent.Text;
            }
            else if (midi is MarkerEvent markerEvent) // maybe think about markers creating new sections
            {
                currentSection.Title = markerEvent.Text;
            }
            else if(midi is TimeSignatureEvent timeSigEvent)
            {
                currentSection.MetData.NotesPerBar = timeSigEvent.Numerator;
                currentSection.MetData.NoteValue = timeSigEvent.Denominator;
                currentSection.MetData.BeatAccents = new int[timeSigEvent.Numerator];
                currentSection.MetData.BeatAccents[0] = 1;
            }
            else if (midi is SetTempoEvent tempoEvent)
            {
                bpm = (int)Math.Round(60_000_000f / tempoEvent.MicrosecondsPerQuarterNote);
                if (!skipToAgogicsEnd)
                {
                    currentSection.MetData.TempoData.Tempo = bpm;
                    lastSection.MetData.TempoData.NextTempo = bpm;
                    currentSection.MetData.TempoData.PreviousTempo = lastSection.MetData.TempoData.IsAgogic ? lastSection.MetData.TempoData.EndTempo : lastSection.MetData.TempoData.Tempo;
                }
            }
            else if (midi is TextEvent textEvent && textEvent.Text.Contains("gradual tempo change"))
            {
                if (textEvent.Text.Contains("start ") && double.TryParse(textEvent.Text.Split("start ")[1], CultureInfo.InvariantCulture, out var bpmDouble))
                {
                    bpm = (int)Math.Round(bpmDouble);
                    currentSection.MetData.TempoData.IsAgogic = true;
                    currentSection.MetData.TempoData.StartTempo = bpm;
                    currentSection.MetData.TempoData.Tempo = bpm;
                    lastSection.MetData.TempoData.NextTempo = bpm;
                    currentSection.MetData.TempoData.PreviousTempo = lastSection.MetData.TempoData.IsAgogic ? lastSection.MetData.TempoData.EndTempo : lastSection.MetData.TempoData.Tempo;
                    skipToAgogicsEnd = true;
                }
                else if (textEvent.Text.Contains("end"))
                {
                    currentSection.MetData.TempoData.EndTempo = bpm;
                    skipToAgogicsEnd = false;
                }
            }
        }

        currentSection.Length = (int)(currentTime.Bars - lastTime.Bars);
        clickTrack.Sections.Add(currentSection);
        return clickTrack;
    }

    private async Task OnFilesChanged()
    {
        // validate midi files
        Dictionary<string, MidiFile> midiFiles = await ValidateMidiFilesAsync();
        
        foreach (KeyValuePair<string, MidiFile> kvp in midiFiles)
        {
            ClickTrackData clickTrack = MidiToClickTrack(kvp.Value);

            // Get title, use filename as fallback
            string title = GetMidiTitle(kvp.Value);
            clickTrack.Title = string.IsNullOrWhiteSpace(title) ? kvp.Key : title;

            await TrackStore.AddAsync(clickTrack);
        }

        _files = new List<IBrowserFile>();
    }
    
    protected override async Task OnInitializedAsync()
    {
        Snackbar.Clear();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomStart;

        Tracks = await TrackStore.GetAllAsync();
    }

    private void OpenClickTrack(int trackID)
    {
        Navigation.NavigateTo($"track?id={trackID}");
    }

    private async Task OpenEditTrackDialogAsync(ClickTrackData track)
    {
        DialogParameters<EditClickTrackDialog>? parameters = new DialogParameters<EditClickTrackDialog>{
            { x => x.ClickTrackTitle, track.Title },
            { x => x.ClickTrackID, track.ID }
        };

        IDialogReference? dialog = await DialogService.ShowAsync<EditClickTrackDialog>(title: "Edit Click Track", parameters);
        DialogResult? result = await dialog.Result;
        
        if (result?.Canceled == false)
        {
            track.Title = (string?)result.Data ?? track.Title;
            await TrackStore.UpdateAsync(track);
        }
    }
}