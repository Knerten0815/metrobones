@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (Data.IsAgogic)
        {
            <MudText Typo=@Typo.subtitle1>Start Tempo:</MudText>
            <MudStack Row=true Spacing=2 Justify=@Justify.FlexStart AlignItems=@AlignItems.Center>
                <MudChip OnClick=@OpenStartTempoDialogAsync Disabled=@(Data.IsPreviousTempoStartTempo && Data.PreviousTempo > 0) Icon=@Icons.Material.Filled.Speed Variant="Variant.Text" Color=@Color.Primary Size=@Size.Medium T=@string>
                    @(Data.StartTempo.ToString()) bpm
                </MudChip>
                <MudCheckBox @bind-Value=Data.IsPreviousTempoStartTempo @bind-Value:after=UpdateAgogics Label="use previous section tempo" Color="Color.Primary" Disabled=@(Data.PreviousTempo <= 0)/>
            </MudStack>
            <br/>
            <MudText Typo=@Typo.subtitle1>End Tempo:</MudText>
            <MudStack Row=true Spacing=2 Justify=@Justify.FlexStart AlignItems=@AlignItems.Center>
                <MudChip OnClick=@OpenEndTempoDialogAsync Disabled=@(Data.IsNextTempoEndTempo && Data.NextTempo > 0) Icon=@Icons.Material.Filled.Speed Variant=@Variant.Text Color=@Color.Primary Size=@Size.Medium T=@string>
                    @(Data.EndTempo.ToString()) bpm
                </MudChip>
                <MudCheckBox @bind-Value=Data.IsNextTempoEndTempo @bind-Value:after=UpdateAgogics Label="use next section tempo" Color=@Color.Primary Disabled=@(Data.NextTempo <= 0)/>
            </MudStack>
        }
        else
        {
            <TempoPicker @bind-Tempo=Data.Tempo/>
        }

        @if (HasAgogicOption)
        {
            <br/>
            <MudCheckBox @bind-Value=@Data.IsAgogic @bind-Value:after=@UpdateAgogics Label="Change tempo over time" Color=@Color.Primary Style="margin: 0 -1rem;"/>
        }
        
    </DialogContent>
    <DialogActions>
        <MudButton OnClick=@Cancel>Cancel</MudButton>
        <MudButton Color=@Color.Primary OnClick=@Submit>OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter, EditorRequired]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public TempoData Data { get; set; } = null!;

    [Parameter]
    public bool HasAgogicOption { get; set; } = false;

    private void UpdateAgogics() => Data.UpdateAgogics();

    private void Submit() => MudDialog.Close(DialogResult.Ok(result: Data));

    private void Cancel() => MudDialog.Cancel();

    private async Task OpenStartTempoDialogAsync()
    {
        DialogParameters<TempoPickerDialog>? parameters = new DialogParameters<TempoPickerDialog>{
            { x => x.Data, new TempoData(Data.StartTempo) },
        };

        IDialogReference? dialog = await DialogService.ShowAsync<TempoPickerDialog>(title: "Edit Start Tempo", parameters);
        DialogResult? result = await dialog.Result;
        
        if (result?.Canceled == false)
        {
            TempoData data = (TempoData)(result.Data ?? new TempoData(Data.StartTempo));
            Data.StartTempo = data.Tempo;
        }
    }

    private async Task OpenEndTempoDialogAsync()
    {
        DialogParameters<TempoPickerDialog>? parameters = new DialogParameters<TempoPickerDialog>{
            { x => x.Data, new TempoData(Data.EndTempo) },
        };

        IDialogReference? dialog = await DialogService.ShowAsync<TempoPickerDialog>(title: "Edit End Tempo", parameters);
        DialogResult? result = await dialog.Result;
        
        if (result?.Canceled == false)
        {
            TempoData data = (TempoData)(result.Data ?? new TempoData(Data.EndTempo));
            Data.EndTempo = data.Tempo;
        }
    }
}
