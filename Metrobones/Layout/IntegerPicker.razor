<MudSlider @bind-Value=Value Min=Min Max=Max Color=@Color.Primary>
    @if(String.IsNullOrEmpty(AdornmentText))
    {
        <MudNumericField Label=@Label @bind-Value=Value T=int Min=@Min Max=@Max Step=1 HideSpinButtons=@false Class="input-center-text" Disabled=@Disabled/>
    }
    else
    {
        <MudNumericField AdornmentText=@AdornmentText Adornment=Adornment.End Label=@Label @bind-Value=Value T=int Min=@Min Max=@Max Step=1 HideSpinButtons=@false Class="input-center-text" Disabled=@Disabled/>
    }
</MudSlider>


@code {
    [Parameter]
    public int Value { get; set; } = 4;
    [Parameter]
    public string Label { get; set; } = "Value";
    [Parameter]
    public string AdornmentText { get; set; } = "";
    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }
    [Parameter]
    public int Min { get; set; } = 1;
    [Parameter]
    public int Max { get; set; } = 1000;
    [Parameter]
    public bool usePowersOfTwo { get; set; } = false;
    [Parameter]
    public bool Disabled { get; set; } = false;
    
    private void Increment(int increment)
    {
        if (Value + increment < Min || Value + increment > Max)
            return;

        if(usePowersOfTwo)
        {
            if (increment > 0)
                Value *= 2;
            else
                Value /= 2;
        }
        else
        {
            Value += increment;
        }
        
        ValueChanged.InvokeAsync(Value);
    }
}
